<Page x:Class="ITV.Views.BackUp.BackUps"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Title="BackUps"
      Background="#F0F2F2"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="ClearType"
      UseLayoutRounding="True">

    <Page.Resources>
        <!-- BOTÓN ENCABEZADO HD (Crear Respaldo - Verde Principal) -->
        <Style x:Key="PrimaryGreenButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#36FF6E"/>
            <Setter Property="Foreground" Value="#1A222B"/>
            <Setter Property="Padding" Value="25,12"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.15" Color="#36FF6E"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2ecc71"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BOTÓN LATERAL: RESTAURAR (Verde Secundario Interactivo) -->
        <Style x:Key="RestoreButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#3A4242"/>
            <Setter Property="BorderBrush" Value="#7D8A8A"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#36FF6E"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#36FF6E"/>
                                <Setter Property="Foreground" Value="#1A222B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BOTÓN LATERAL: BORRAR (Gris / Coherente con Cancelar) -->
        <Style x:Key="DeleteButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#7D8A8A"/>
            <Setter Property="BorderBrush" Value="#7D8A8A"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#7D8A8A"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#7D8A8A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <!-- REJILLA PRINCIPAL QUE SINCRONIZA CABECERA Y CONTENIDO -->
    <Grid Margin="35">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="220"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. HEADER HD (Parte Izquierda) -->
        <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,0,25">
            <TextBlock Text="COPIAS DE SEGURIDAD" FontSize="28" FontWeight="Black" Foreground="#3A4242"/>
            <Border Height="3" Width="50" Background="#FF63C2" HorizontalAlignment="Left" Margin="2,6,0,0" CornerRadius="2">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" Color="#FF63C2" Opacity="0.4" ShadowDepth="0"/>
                </Border.Effect>
            </Border>
        </StackPanel>

        <!-- BOTÓN CREAR (Alineado perfectamente encima del panel lateral derecho) -->
        <Button Grid.Row="0" Grid.Column="1" 
                Style="{StaticResource PrimaryGreenButtonStyle}" 
                VerticalAlignment="Center" 
                HorizontalAlignment="Stretch"
                Margin="0,0,0,25"
                Command="{Binding CrearCommand}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,10,0" VerticalAlignment="Center" FontWeight="Bold"/>
                <TextBlock Text="CREAR RESPALDO" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>

        <!-- 2. LISTADO DE PUNTOS DE RESTAURACIÓN -->
        <Border Grid.Row="1" Grid.Column="0" Background="White" CornerRadius="15" BorderBrush="#E0E5E5" BorderThickness="1" Margin="0,0,20,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.04" Color="Black"/>
            </Border.Effect>

            <ListView ItemsSource="{Binding Rutas}"
                      SelectedItem="{Binding RutaSeleccionada}"
                      HorizontalContentAlignment="Stretch"
                      BorderThickness="0"
                      Background="Transparent"
                      Margin="10"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="ItemBorder" 
                                Padding="16,14" 
                                Margin="5,5,5,8" 
                                Background="#F8FAFA" 
                                BorderBrush="#E2E8F0" 
                                BorderThickness="1"
                                CornerRadius="10">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.02" Color="Black"/>
                            </Border.Effect>
                            
                            <DockPanel>
                                <TextBlock x:Name="ItemIcon" Text="💾" Margin="5,0,15,0" VerticalAlignment="Center" FontSize="20" Opacity="0.7"/>
                                <TextBlock Text="{Binding}" FontSize="13" FontWeight="SemiBold" Foreground="#3A4242" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </Border>
                        
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListViewItem}}, Path=IsSelected}" Value="True">
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#FF63C2"/>
                                <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1.5"/>
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FFF5FB"/>
                                <Setter TargetName="ItemIcon" Property="Opacity" Value="1"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- PANEL LATERAL DE ACCIONES CRÍTICAS -->
        <Border Grid.Row="1" Grid.Column="1" Background="White" CornerRadius="15" Padding="20" BorderBrush="#E0E5E5" BorderThickness="1" VerticalAlignment="Top">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.04" Color="Black"/>
            </Border.Effect>
            
            <StackPanel>
                <TextBlock Text="ACCIONES" FontSize="11" FontWeight="ExtraBold" Foreground="#7D8A8A" HorizontalAlignment="Center" Margin="0,0,0,15" TextDecorations="Underline"/>
                
                <Button Content="🔄 RESTAURAR" 
                        Command="{Binding RestaurarCommand}" 
                        Style="{StaticResource RestoreButtonStyle}" 
                        HorizontalAlignment="Stretch"
                        Margin="0,0,0,12"/>
                
                <Button Content="🗑 BORRAR" 
                        Command="{Binding BorrarCommand}" 
                        Style="{StaticResource DeleteButtonStyle}" 
                        HorizontalAlignment="Stretch"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>