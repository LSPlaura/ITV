<Page x:Class="ITV.Views.BackUp.BackUps"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Title="BackUps"
      Background="#FBFBFB"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="ClearType"
      UseLayoutRounding="True">

    <Page.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="30,0"/>
            <Setter Property="Margin" Value="12,0,0,0"/>
            <Setter Property="MinWidth" Value="125"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="ScaleTransform.ScaleX" Value="0.98"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#7D8A8A" Height="80" Padding="30,0" Margin="0,0,0,25" CornerRadius="10">
            <DockPanel VerticalAlignment="Center">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="BACKUPS" FontSize="28" FontWeight="ExtraBold" Foreground="White"/>
                    <TextBlock Text="Gestione sus puntos de restauración" FontSize="13" Foreground="White" Opacity="0.9"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="✚ CREAR" 
                            Style="{StaticResource ActionButton}" 
                            Command="{Binding CrearCommand}"
                            Background="#36FF6E"
                            Foreground="#1A222B"/>
                    
                    <Button Content="↺ RESTAURAR" 
                            Style="{StaticResource ActionButton}" 
                            Command="{Binding RestaurarCommand}"
                            Background="#FF63C2"
                            Foreground="White"/>
                    
                    <Button Content="🗑 BORRAR" 
                            Style="{StaticResource ActionButton}"
                            Command="{Binding BorrarCommand}"
                            Background="#FF63C2"
                            Foreground="White"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- LIST VIEW CON BORDER -->
        <Border Grid.Row="1"
                BorderBrush="#7D8A8A"
                BorderThickness="2"
                CornerRadius="10"
                Padding="0">
            
            <ListView ItemsSource="{Binding Rutas}"
                      SelectedItem="{Binding RutaSeleccionada}"
                      HorizontalContentAlignment="Stretch"
                      BorderThickness="0"
                      Background="Transparent"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="ItemBorder" 
                                Padding="20" 
                                Margin="12,12,12,0" 
                                Background="White" 
                                BorderBrush="#7D8A8A" 
                                BorderThickness="2"
                                CornerRadius="10">
                            
                            <DockPanel>
                                <TextBlock Text="📋" Margin="0,0,20,0" VerticalAlignment="Center" FontSize="24"/>
                                
                                <!-- INFORMACIÓN -->
                                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding}" FontSize="16" FontWeight="Bold" Foreground="#1A222B" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListViewItem}}, Path=IsSelected}" Value="True">
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#FF63C2"/>
                                <Setter TargetName="ItemBorder" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FFF5FB"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</Page>