<Page x:Class="ITV.Views.Citas.Citas"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:ITV.Views.Citas"
      mc:Ignorable="d" 
      Title="Citas"
      Background="#FBFBFB"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="ClearType"
      UseLayoutRounding="True">

    <Page.Resources>
        <Style x:Key="AddButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="MinWidth" Value="115"/>
            <Setter Property="Padding" Value="40,0"/> <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#005A9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <RowDefinition Height="*"/>    </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="30,40,30,30" HorizontalAlignment="Center">
            
            <TextBlock Text="Gestión de Citas"
                       FontSize="32" 
                       FontWeight="Bold"
                       Foreground="#1A1C1E"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                
                <Border Background="White" 
                        BorderBrush="#DCDFE3" 
                        BorderThickness="1" 
                        CornerRadius="12" 
                        Width="550" 
                        Height="50">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.03"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔍" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#95A5A6" FontSize="18"/>
                        <TextBox Grid.Column="1" 
                                 BorderThickness="0" 
                                 Background="Transparent" 
                                 VerticalContentAlignment="Center" 
                                 Margin="5,0,20,0"
                                 FontSize="16"
                                 Foreground="#2C3E50"
                                 x:Name="TxtBuscar"/>
                    </Grid>
                </Border>

                <Button Content="✚ Nueva Cita" 
                        Style="{StaticResource AddButtonStyle}" 
                        Margin="15,0,0,0"
                        Click="Formulario_Click">
                    <Button.Effect>
                        <DropShadowEffect BlurRadius="15" ShadowDepth="4" Opacity="0.1"/>
                    </Button.Effect>
                </Button>
                
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" 
                Margin="30,0,30,30" 
                Background="White" 
                CornerRadius="15" 
                BorderBrush="#E0E0E0" 
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.05"/>
            </Border.Effect>
            
            <DataGrid x:Name="DgCitas"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      Background="Transparent"
                      BorderThickness="0"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F0F2F5"
                      RowHeight="48"
                      FontSize="14">
                
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F8F9FA"/>
                        <Setter Property="Foreground" Value="#5C636A"/>
                        <Setter Property="Padding" Value="15,15"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#E0E0E0"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Matrícula" Binding="{Binding Matricula}" Width="110" />
                    <DataGridTextColumn Header="Marca" Binding="{Binding Marca}" Width="0.8*" />
                    <DataGridTextColumn Header="Modelo" Binding="{Binding Modelo}" Width="0.8*" />
                    <DataGridTextColumn Header="F. Matriculación" 
                                        Binding="{Binding FechaMatriculacion, StringFormat=\{0:dd/MM/yyyy HH:mm:ss\}}" 
                                        Width="1.2*" MinWidth="170"/>
                    <DataGridTextColumn Header="F. Inspección" 
                                        Binding="{Binding FechaInspeccion, StringFormat=\{0:dd/MM/yyyy HH:mm:ss\}}" 
                                        Width="1.2*" MinWidth="170"/>
                    <DataGridTextColumn Header="Cilindrada" Binding="{Binding Cilindrada}" Width="Auto" />
                    <DataGridTextColumn Header="Motor" Binding="{Binding Motor}" Width="*" MinWidth="150"/>
                    <DataGridTextColumn Header="DNI Dueño" Binding="{Binding DniDueño}" Width="120" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>