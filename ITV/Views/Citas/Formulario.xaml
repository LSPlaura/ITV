<Window x:Class="ITV.Views.Citas.Formulario"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Editar Cita" 
        Height="720" Width="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FBFBFB"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <!-- Estilo de etiquetas alineado con Vista de Detalle -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#7D8A8A"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Opacity" Value="0.8"/>
        </Style>

        <!-- Cajas de texto estilizadas con bordes redondeados suaves -->
        <Style x:Key="FormField" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" 
                                Background="White" 
                                BorderBrush="#DCDFE3" 
                                BorderThickness="1" 
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#7D8A8A"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF63C2"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 🌟 NUEVO: Estilo DatePicker HD importado de tu módulo de gestión -->
        <Style x:Key="DatePickerHD" TargetType="DatePicker">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Grid>
                            <Border x:Name="border" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0" Padding="12,0" VerticalContentAlignment="Center" Foreground="#3A4242" Background="Transparent" BorderThickness="0"/>
                                    <Button x:Name="PART_Button" Grid.Column="1" Width="35" Background="Transparent" BorderThickness="0" Foreground="#7D8A8A" FontSize="12" Content="📅" Cursor="Hand"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" PlacementTarget="{Binding ElementName=border}" IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" AllowsTransparency="True" Placement="Bottom">
                                <Border Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="8" Padding="10">
                                    <Calendar x:Name="PART_Calendar" Foreground="#3A4242"/>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#7D8A8A"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF63C2"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botones redondeados unificados -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Width" Value="160"/>
            <Setter Property="Margin" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#7D8A8A" Height="80">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Titulo}"
                            Foreground="White" 
                            FontSize="24" 
                            FontWeight="ExtraBold" 
                            HorizontalAlignment="Center"/>
                <Border Height="3" Width="40" Background="#FF63C2" Margin="0,8,0,0" CornerRadius="1.5" HorizontalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#FF63C2" Opacity="0.8"/>
                    </Border.Effect>
                </Border>
            </StackPanel>
        </Border>

        <!-- CUERPO DE EDICIÓN -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40,25,40,25" MaxWidth="500" HorizontalAlignment="Center">

                <!-- GRID DE FORMULARIO DE DOS COLUMNAS -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- MATRÍCULA -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                        <TextBlock Text="MATRÍCULA" Style="{StaticResource FieldLabel}" Foreground="#FF63C2"/>
                        <TextBox Style="{StaticResource FormField}" Text="{Binding Matricula, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- MARCA -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="MARCA" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource FormField}" Text="{Binding Marca, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- MODELO -->
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="MODELO" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource FormField}" Text="{Binding Modelo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- CILINDRADA -->
                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="CILINDRADA (CC)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource FormField}" Text="{Binding Cilindrada, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- TIPO DE MOTOR -->
                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="TIPO DE MOTOR" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Height="40" Margin="0,0,0,20"
                                  ItemsSource="{Binding TiposMotor}"
                                  SelectedItem="{Binding MotorSeleccionado, Mode=TwoWay}">
                            <ComboBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </ComboBox.Resources>
                        </ComboBox>
                    </StackPanel>

                    <!-- DNI DEL DUEÑO -->
                    <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2">
                        <TextBlock Text="DNI DEL DUEÑO" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource FormField}" Text="{Binding Dni, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <!-- FECHAS EN DOS COLUMNAS CON ESTILO HD -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- FECHA MATRICULACIÓN -->
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="FECHA DE MATRICULACIÓN" Style="{StaticResource FieldLabel}"/>
                        <DatePicker Style="{StaticResource DatePickerHD}" SelectedDate="{Binding FechaMatriculacion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- FECHA INSPECCIÓN -->
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="FECHA DE INSPECCIÓN" Style="{StaticResource FieldLabel}"/>
                        <DatePicker Style="{StaticResource DatePickerHD}" SelectedDate="{Binding FechaInspeccion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <!-- SEPARADOR -->
                <Border Height="1" Background="#E0E5E5" Margin="0,10,0,25"/>

                <!-- ACCIONES -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="GUARDAR CAMBIOS" 
                            Background="#36FF6E" Foreground="#1A222B"
                            Style="{StaticResource ActionButtonStyle}"
                            Command="{Binding GuardarCambiosCommand}"/>

                    <Button Content="CANCELAR" 
                            Background="#7D8A8A" Foreground="White"
                            Style="{StaticResource ActionButtonStyle}"
                            Command="{Binding CancelarCommand}"/>
                </StackPanel>
                
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>