<Window x:Class="ITV.Views.Citas.Vista"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Detalle de la Cita" 
        Height="780" Width="600"
        WindowStartupLocation="CenterScreen"
        Background="#FBFBFB">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#7D8A8A"/> <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="ValueDisplay" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#1A1C1E"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="Padding" Value="5,2"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Width" Value="140"/>
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40,30" MaxWidth="500" HorizontalAlignment="Center">

                <TextBlock Text="Información de la Cita" FontSize="26" FontWeight="Bold" Margin="0,0,0,35" HorizontalAlignment="Center" Foreground="#1A1C1E"/>

                <TextBlock Text="MATRÍCULA" Style="{StaticResource FieldLabel}"/>
                <TextBlock x:Name="LblMatricula" Text="1234-BBB" Style="{StaticResource ValueDisplay}"/>

                <TextBlock Text="MARCA" Style="{StaticResource FieldLabel}"/>
                <TextBlock x:Name="LblMarca" Text="Toyota" Style="{StaticResource ValueDisplay}"/>

                <TextBlock Text="MODELO" Style="{StaticResource FieldLabel}"/>
                <TextBlock x:Name="LblModelo" Text="Corolla Hybrid" Style="{StaticResource ValueDisplay}"/>

                <TextBlock Text="DNI DEL DUEÑO" Style="{StaticResource FieldLabel}"/>
                <TextBlock x:Name="LblDni" Text="12345678Z" Style="{StaticResource ValueDisplay}"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="CILINDRADA (CC)" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="LblCilindrada" Text="1800" Style="{StaticResource ValueDisplay}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="TIPO DE MOTOR" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="LblMotor" Text="Híbrido" Style="{StaticResource ValueDisplay}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="FECHA DE MATRICULACIÓN" Style="{StaticResource FieldLabel}"/>
                <TextBlock x:Name="LblFechaMatriculacion" Text="15/05/2021" Style="{StaticResource ValueDisplay}"/>

                <TextBlock Text="FECHA DE INSPECCIÓN" Style="{StaticResource FieldLabel}"/>
                <TextBlock x:Name="LblFechaInspeccion" Text="22/06/2026 10:30" Style="{StaticResource ValueDisplay}" FontWeight="SemiBold" Foreground="#116E6B"/>

                <Border Height="1" Background="#E0E5E5" Margin="0,10,0,30"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                    <Button Content="EDITAR" 
                            Background="#36FF6E" Foreground="#1A222B"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="Edicion_Click"/>

                    <Button Content="BORRAR" 
                                                                                   Background="#FF63C2" Foreground="White"
                                                                                   Style="{StaticResource ActionButtonStyle}"/>

                    <Button Content="EXPORTAR" 
                            Background="#7D8A8A" Foreground="White"
                            Style="{StaticResource ActionButtonStyle}"/>

                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>