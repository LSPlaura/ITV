<Page x:Class="ITV.Views.ExportImport.ExportImport"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d" 
      Title="Gestión de Datos"
      Background="#F0F2F2"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="ClearType"
      UseLayoutRounding="True">

    <Page.Resources>
        <!-- BOTÓN IMPORTAR HD (Verde Corporativo) -->
        <Style x:Key="ImportButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#36FF6E"/>
            <Setter Property="Foreground" Value="#1A222B"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Width" Value="125"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.12" Color="#36FF6E"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2ecc71"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BOTÓN EXPORTAR HD (Rosa Corporativo) -->
        <Style x:Key="ExportButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF63C2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Width" Value="125"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.2" Color="#FF63C2"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E04FA9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ETIQUETAS ESTRUCTURADAS HD -->
        <Style x:Key="FormatTitleLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="Foreground" Value="#3A4242"/>
        </Style>

        <Style x:Key="FormatDescriptionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#7D8A8A"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="Opacity" Value="0.8"/>
        </Style>
    </Page.Resources>

    <Grid Margin="35">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. HEADER HD -->
        <StackPanel Grid.Row="0" Margin="0,0,0,25" VerticalAlignment="Center">
            <TextBlock Text="GESTIÓN DE DATOS" FontSize="28" FontWeight="Black" Foreground="#3A4242"/>
            <Border Height="3" Width="50" Background="#FF63C2" HorizontalAlignment="Left" Margin="2,6,0,0" CornerRadius="2">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" Color="#FF63C2" Opacity="0.4" ShadowDepth="0"/>
                </Border.Effect>
            </Border>
        </StackPanel>

        <!-- 2. CONTENIDO EN CONTENEDORES HD -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-10,0">
            <StackPanel>

                <!-- TARJETA: CSV -->
                <Border Background="White" CornerRadius="15" BorderBrush="#E0E5E5" BorderThickness="1" Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.04" Color="Black"/>
                    </Border.Effect>
                    <Grid Margin="25,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Icono Identificativo de Formato -->
                        <TextBlock Grid.Column="0" Text="📊" FontSize="24" Margin="5,0,20,0" VerticalAlignment="Center" Opacity="0.8"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="FORMATO CSV" Style="{StaticResource FormatTitleLabel}"/>
                            <TextBlock Text="Valores separados por comas estructurados (.csv)" Style="{StaticResource FormatDescriptionLabel}"/>
                        </StackPanel>

                        <Button Grid.Column="2" Style="{StaticResource ImportButtonStyle}" Margin="0,0,12,0" Command="{Binding ImportarCsvCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📥 " FontWeight="Normal" VerticalAlignment="Center"/>
                                <TextBlock Text="IMPORTAR" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="3" Style="{StaticResource ExportButtonStyle}" Command="{Binding ExportarCsvCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📤 " FontWeight="Normal" VerticalAlignment="Center"/>
                                <TextBlock Text="EXPORTAR" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- TARJETA: JSON -->
                <Border Background="White" CornerRadius="15" BorderBrush="#E0E5E5" BorderThickness="1" Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.04" Color="Black"/>
                    </Border.Effect>
                    <Grid Margin="25,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="☕" FontSize="24" Margin="5,0,20,0" VerticalAlignment="Center" Opacity="0.8"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="FORMATO JSON" Style="{StaticResource FormatTitleLabel}"/>
                            <TextBlock Text="Estructura jerárquica de datos ligera (.json)" Style="{StaticResource FormatDescriptionLabel}"/>
                        </StackPanel>

                        <Button Grid.Column="2" Style="{StaticResource ImportButtonStyle}" Margin="0,0,12,0" Command="{Binding ImportarJsonCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📥 " FontWeight="Normal" VerticalAlignment="Center"/>
                                <TextBlock Text="IMPORTAR" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="3" Style="{StaticResource ExportButtonStyle}" Command="{Binding ExportarJsonCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📤 " FontWeight="Normal" VerticalAlignment="Center"/>
                                <TextBlock Text="EXPORTAR" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- TARJETA: XML -->
                <Border Background="White" CornerRadius="15" BorderBrush="#E0E5E5" BorderThickness="1" Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.04" Color="Black"/>
                    </Border.Effect>
                    <Grid Margin="25,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="📑" FontSize="24" Margin="5,0,20,0" VerticalAlignment="Center" Opacity="0.8"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="FORMATO XML" Style="{StaticResource FormatTitleLabel}"/>
                            <TextBlock Text="Intercambio de datos mediante etiquetas extendidas (.xml)" Style="{StaticResource FormatDescriptionLabel}"/>
                        </StackPanel>

                        <Button Grid.Column="2" Style="{StaticResource ImportButtonStyle}" Margin="0,0,12,0" Command="{Binding ImportarXmlCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📥 " FontWeight="Normal" VerticalAlignment="Center"/>
                                <TextBlock Text="IMPORTAR" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="3" Style="{StaticResource ExportButtonStyle}" Command="{Binding ExportarXmlCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📤 " FontWeight="Normal" VerticalAlignment="Center"/>
                                <TextBlock Text="EXPORTAR" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>