<Page x:Class="ITV.Views.ExportImport.ExportImport"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d" 
      Title="Gestión de Datos"
      Background="#FBFBFB"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="ClearType"
      TextOptions.TextHintingMode="Fixed"
      SnapsToDevicePixels="True"
      UseLayoutRounding="True">

    <Page.Resources>
        <!-- BOTÓN IMPORTAR (Verde) -->
        <Style x:Key="ImportButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#36FF6E"/>
            <Setter Property="Foreground" Value="#1A1C1E"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BOTÓN EXPORTAR (Rosa) -->
        <Style x:Key="ExportButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF63C2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ETIQUETA TÍTULO FORMATO -->
        <Style x:Key="FormatTitleLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1A1C1E"/>
        </Style>

        <!-- ETIQUETA DESCRIPCIÓN -->
        <Style x:Key="FormatDescriptionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#7D8A8A"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0" Margin="35,10,0,25" VerticalAlignment="Center">
            <TextBlock Text="GESTIÓN DE DATOS" 
                       FontSize="28" 
                       FontWeight="Black" 
                       Foreground="#3A4242"/>
            <Border Height="3" Width="50" Background="#36FF6E" HorizontalAlignment="Left" Margin="2,6,0,0" CornerRadius="2">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" Color="#36FF6E" Opacity="0.4" ShadowDepth="0"/>
                </Border.Effect>
            </Border>
        </StackPanel>

        <!-- CONTENIDO -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="35,0,35,35">

                <!-- CSV -->
                <Border Background="White" CornerRadius="15" 
                        BorderBrush="#E0E5E5" BorderThickness="1" Margin="0,0,0,25">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="2" Opacity="0.06" Color="#000000"/>
                    </Border.Effect>
                    <Grid Margin="30,25">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Formato CSV" Style="{StaticResource FormatTitleLabel}"/>
                            <TextBlock Text="Valores separados por comas (.csv)" Style="{StaticResource FormatDescriptionLabel}"/>
                        </StackPanel>

                        <Button Grid.Column="1" Content="Importar" Style="{StaticResource ImportButtonStyle}" Margin="10,0" Command="{Binding ImportarCsvCommand}"/>
                        <Button Grid.Column="2" Content="Exportar" Style="{StaticResource ExportButtonStyle}" Margin="10,0,0,0" Command="{Binding ExportarCsvCommand}"/>
                    </Grid>
                </Border>

                <!-- JSON -->
                <Border Background="White" CornerRadius="15" 
                        BorderBrush="#E0E5E5" BorderThickness="1" Margin="0,0,0,25">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="2" Opacity="0.06" Color="#000000"/>
                    </Border.Effect>
                    <Grid Margin="30,25">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Formato JSON" Style="{StaticResource FormatTitleLabel}"/>
                            <TextBlock Text="Estructura de datos ligera (.json)" Style="{StaticResource FormatDescriptionLabel}"/>
                        </StackPanel>

                        <Button Grid.Column="1" Content="Importar" Style="{StaticResource ImportButtonStyle}" Margin="10,0" Command="{Binding ImportarJsonCommand}"/>
                        <Button Grid.Column="2" Content="Exportar" Style="{StaticResource ExportButtonStyle}" Margin="10,0,0,0" Command="{Binding ExportarJsonCommand}"/>
                    </Grid>
                </Border>

                <!-- XML -->
                <Border Background="White" CornerRadius="15" 
                        BorderBrush="#E0E5E5" BorderThickness="1" Margin="0,0,0,25">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="2" Opacity="0.06" Color="#000000"/>
                    </Border.Effect>
                    <Grid Margin="30,25">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Formato XML" Style="{StaticResource FormatTitleLabel}"/>
                            <TextBlock Text="Etiquetado jerárquico (.xml)" Style="{StaticResource FormatDescriptionLabel}"/>
                        </StackPanel>

                        <Button Grid.Column="1" Content="Importar" Style="{StaticResource ImportButtonStyle}" Margin="10,0" Command="{Binding ImportarXmlCommand}"/>
                        <Button Grid.Column="2" Content="Exportar" Style="{StaticResource ExportButtonStyle}" Margin="10,0,0,0" Command="{Binding ExportarXmlCommand}"/>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>