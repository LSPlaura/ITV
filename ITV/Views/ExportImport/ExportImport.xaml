<Page x:Class="ITV.Views.ExportImport.ExportImport"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d" 
      Title="Gestión de Datos"
      Background="#FBFBFB"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="ClearType"
      TextOptions.TextHintingMode="Fixed"
      SnapsToDevicePixels="True"
      UseLayoutRounding="True">

    <Page.Resources>
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#0D6EFD"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Width" Value="110"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="60,40">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="0,15" Background="White" CornerRadius="12" 
                BorderBrush="#E0E0E0" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="2" Opacity="0.05" Color="#000000"/>
            </Border.Effect>
            <Grid Margin="40,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Formato CSV" FontSize="20" FontWeight="SemiBold" Foreground="#111111" FontFamily="Segoe UI Variable Display"/>
                    <TextBlock Text="Valores separados por comas (.csv)" FontSize="13" Foreground="#666666" Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" Content="BackUps" Style="{StaticResource ModernButton}" Margin="10,0" Click="ImportarCsv_Click" Background="#0078D4"/>
                <Button Grid.Column="2" Content="Exportar" Style="{StaticResource ModernButton}" Margin="0,0" Click="ExportarCsv_Click" Background="#107C10"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="0,15" Background="White" CornerRadius="12" 
                BorderBrush="#E0E0E0" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="2" Opacity="0.05" Color="#000000"/>
            </Border.Effect>
            <Grid Margin="40,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Formato JSON" FontSize="20" FontWeight="SemiBold" Foreground="#111111" FontFamily="Segoe UI Variable Display"/>
                    <TextBlock Text="Estructura de datos ligera (.json)" FontSize="13" Foreground="#666666" Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" Content="BackUps" Style="{StaticResource ModernButton}" Margin="10,0" Click="ImportarJson_Click" Background="#0078D4"/>
                <Button Grid.Column="2" Content="Exportar" Style="{StaticResource ModernButton}" Margin="0,0" Click="ExportarJson_Click" Background="#107C10"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Margin="0,15" Background="White" CornerRadius="12" 
                BorderBrush="#E0E0E0" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="2" Opacity="0.05" Color="#000000"/>
            </Border.Effect>
            <Grid Margin="40,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Formato XML" FontSize="20" FontWeight="SemiBold" Foreground="#111111" FontFamily="Segoe UI Variable Display"/>
                    <TextBlock Text="Etiquetado jerárquico (.xml)" FontSize="13" Foreground="#666666" Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" Content="BackUps" Style="{StaticResource ModernButton}" Margin="10,0" Click="ImportarXml_Click" Background="#0078D4"/>
                <Button Grid.Column="2" Content="Exportar" Style="{StaticResource ModernButton}" Margin="0,0" Click="ExportarXml_Click" Background="#107C10"/>
            </Grid>
        </Border>
    </Grid>
</Page>