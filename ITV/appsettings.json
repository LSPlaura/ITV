{
  "Repository": {
    "Type": "Dapper",
    "DataBase": "Data Source=Repository/citas.db",
    "Folder": "Repository"
  },
  "Storage": {
    "Type": "json",
    "File": "Vehiculoa",
    "Folder": "Data"
  },
  "BackUp": {
    "File": "_BackUp",
    "Folder": "_BackUp.zip"
  },
  "Cache": {
    "Max": 10
  },
  "Service": {
    "isLogical": true,
    "seed": true
  },
  "Serilog": {
  "Using": [
    "Serilog.Sinks.Console",
    "Serilog.Sinks.File"
  ],
  "MinimumLevel": "Debug",
  "WriteTo": [
    {
      "Name": "Console",
      "Args": {
        "outputTemplate": "{Timestamp:HH:mm:ss.fff} [{Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
      }
    },
    {
      "Name": "File",
      "Args": {
        "path": "log/log-.txt",
        "rollingInterval": "Day",
        "retainedFileCountLimit": 7,
        "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
      }
    }
  ]
}
}